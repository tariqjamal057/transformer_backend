// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransformerStatus {
  AVAILABLE
  DAMAGED
  REPAIRED
}

enum UserRole {
  OWNER
  MANAGER
  DATA_FEEDER
  SUPERVISOR
}

model Consignee {
  id        String   @id @default(cuid())
  name      String
  address   String
  gstNo     String
  email     String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  finalInspectionConsignees FinalInspectionConsignee[]
  deliveryChallans          DeliveryChallan[]

  @@map("consignees")
}

model DeliverySchedule {
  id                    String   @id @default(cuid())
  tnNumber              String   @unique
  rating                Int
  wound                 String
  phase                 String
  loa                   String
  loaDate               DateTime
  po                    String
  poDate                DateTime
  commencementDays      Int
  commencementDate      DateTime
  deliveryScheduleDate  DateTime
  imposedLetters        Json     // Array of {imposedLetterNo: string, date: string}
  liftingLetters        Json     // Array of {liftingLetterNo: string, date: string}
  guaranteePeriodMonths Int
  totalQuantity         Int
  chalanDescription     String
  deliverySchedule      Json     // Array of {start: string, end: string, quantity: string}
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  finalInspections FinalInspection[]

  @@map("delivery_schedules")
}

model FinalInspection {
  id                  String   @id @default(cuid())
  deliveryScheduleId  String
  serialNumberFrom    Int
  serialNumberTo      Int
  offerDate           DateTime
  offeredQuantity     Int
  inspectionDate      DateTime
  inspectedQuantity   Int
  inspectionOfficers  Json     // Array of strings
  nominationLetterNo  String?
  nominationDate      DateTime?
  diNo                String
  diDate              DateTime
  warranty            String
  consignees          Json     // Array of consignee objects with quantities
  sealingDetails      Json     // Array of {trfSiNo: string, polySealNo: string}
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // Relations
  deliverySchedule    DeliverySchedule         @relation(fields: [deliveryScheduleId], references: [id])
  finalInspectionConsignees FinalInspectionConsignee[]
  transformers        FinalInspectionTransformer[]
  deliveryChallans    DeliveryChallan[]

  @@map("final_inspections")
}

model Transformer {
  id        String             @id @default(cuid())
  serialNo  String             @unique
  status    TransformerStatus  @default(AVAILABLE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relations
  finalInspections FinalInspectionTransformer[]

  @@map("transformers")
}

// Junction table for FinalInspection and Consignee (many-to-many)
model FinalInspectionConsignee {
  id                  String   @id @default(cuid())
  finalInspectionId   String
  consigneeId         String
  quantity            Int
  subSerialNumber     String   // e.g., "120 TO 240"
  createdAt           DateTime @default(now())

  // Relations
  finalInspection     FinalInspection @relation(fields: [finalInspectionId], references: [id], onDelete: Cascade)
  consignee           Consignee       @relation(fields: [consigneeId], references: [id], onDelete: Cascade)

  @@unique([finalInspectionId, consigneeId])
  @@map("final_inspection_consignees")
}

// Junction table for FinalInspection and Transformer (damaged/repaired)
model FinalInspectionTransformer {
  id                String   @id @default(cuid())
  finalInspectionId String
  transformerId     String
  createdAt         DateTime @default(now())

  // Relations
  finalInspection   FinalInspection @relation(fields: [finalInspectionId], references: [id], onDelete: Cascade)
  transformer       Transformer     @relation(fields: [transformerId], references: [id], onDelete: Cascade)

  @@unique([finalInspectionId, transformerId])
  @@map("final_inspection_transformers")
}

model DeliveryChallan {
  id                    String   @id @default(cuid())
  finalInspectionId     String
  challanNo             String
  subSerialNumberFrom   String?
  subSerialNumberTo     String?
  consignorName         String
  consignorAddress      String
  consignorPhone        String
  consignorGST          String
  consignorEmail        String
  consigneeId           String
  truckDriverName       String
  lorryNo               String
  challanDescription    String
  materialDescriptionId String
  challanCreatedAt      DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  finalInspection       FinalInspection     @relation(fields: [finalInspectionId], references: [id])
  consignee             Consignee           @relation(fields: [consigneeId], references: [id])
  materialDescription   MaterialDescription @relation(fields: [materialDescriptionId], references: [id])
  gpFailures            GPFailure[]
  deliveryDetail        DeliveryDetail?
  newGpReceiptRecord    NewGPReceiptRecord?

  @@map("delivery_challans")
}

model GPFailure {
  id                String   @id @default(cuid())
  deliveryChallanId String
  trfsiNo           String
  rating            String
  subDivision       String
  failureDetails    Json     // Array of {failureDate: string, informationDate: string, place: string}
  guaranteeExpiry   DateTime
  guaranteeStatus   String   // "Under Guarantee" or "Expired"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  failureAnalysis   FailureAnalysis?

  // Relations
  deliveryChallan   DeliveryChallan @relation(fields: [deliveryChallanId], references: [id])

  @@map("gp_failures")
}

model GPReceiptNote {
  id                        String   @id @default(cuid())
  selectDateFrom            DateTime
  selectDateTo              DateTime
  consigneeName             String
  accountReceiptNoteNo      String
  accountReceiptNoteDate    DateTime
  acos                      String
  discomReceiptNoteNo       String
  discomReceiptNoteDate     DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relation
  newGpReceiptRecords       NewGPReceiptRecord[]

  @@map("gp_receipt_notes")
}

model FailureAnalysis {
  id                      String    @id @default(cuid())
  acosName                String
  reasonOfFailure         String
  
  newGPReceiptRecordId    String    @unique
  newGPReceiptRecord      NewGPReceiptRecord @relation(fields: [newGPReceiptRecordId], references: [id])

  gpFailureId             String    @unique
  gpFailure               GPFailure @relation(fields: [gpFailureId], references: [id])
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("failure_analyses")
}

model TN {
  id        String   @id @default(cuid())
  tnNumber  String   @unique
  discom    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tns")
}

model LOA {
  id        String   @id @default(cuid())
  tnDetail  String
  loa       String
  po        String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("loas")
}

model User {
  id        String   @id @default(cuid())
  name      String
  loginId   String   @unique
  number    String
  password  String
  role      UserRole
  pages     Json     // Array of accessible page URLs
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model NewGPInformation {
  id                        String   @id @default(cuid())
  challanReceiptedItemNo    String
  challanReceiptedDate      DateTime
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relation
  records                   NewGPInformationRecord[]

  @@map("new_gp_information")
}

model NewGPInformationRecord {
  id                        String   @id @default(cuid())
  newGPInformationId        String
  newGPInformation          NewGPInformation @relation(fields: [newGPInformationId], references: [id])
  
  trfsiNo                   String
  rating                    String
  polyCarbonateSealNo       String
  receivedFromACOS          String?
  inspectionDate            DateTime?
  challanNo                 String
  challanDate               DateTime?
  consigneeName             String
  isMatched                 Boolean  @default(false)

  @@map("new_gp_information_records")
}


enum ActivityType {
  CREATE
  UPDATE
  DELETE
}

model ActivityLog {
  id          String      @id @default(cuid())
  doneBy      String      // ID of the user who performed the action
  doneByName  String      // Name of the user who performed the action
  type        ActivityType
  modelName   String      // e.g., 'Transformer', 'User', 'Consignee'
  recordId    String      // The ID of the record that was affected
  before      Json?       // JSON representation of the data before the change
  after       Json?       // JSON representation of a fter the change
  timestamp   DateTime    @default(now())

  @@map("activity_logs")
}

model Company {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String
  phone     String
  gstNo     String
  email     String
  logo      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  supplyTenders SupplyTender[]

  @@map("companies")
}

model SupplyTender {
  id         String   @id @default(cuid())
  name       String
  tenderNo   String   @unique
  tenderDate DateTime
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id])

  @@map("supply_tenders")
}

model Defferment {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("defferments")
}

model DeliveryDetail {
  id                   String    @id @default(cuid())
  deliveryChalanId     String    @unique
  receiptedChallanNo   String
  receiptedChallanDate DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deliveryChallan      DeliveryChallan @relation(fields: [deliveryChalanId], references: [id])

  @@map("delivery_details")
}

model MaterialDescription {
  id               String            @id @default(cuid())
  name             String
  phase            String
  rating           String
  wound            String
  description      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deliveryChallans DeliveryChallan[]

  @@map("material_descriptions")
}

model ChalanDescription {
  id          String   @id @default(cuid())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chalan_descriptions")
}

model DamagedTransformer {
  id                            String    @id @default(cuid())
  serialNo                      String    @unique
  snNumberRange                 String?
  finalInspectionId             String?
  reasonOfDamaged               String?
  ctlReportNo                   String?
  ctlReportDate                 DateTime?
  liftingLetterNo               String?
  liftingLetterDate             DateTime?
  liftingFromAcos               String?
  dateOfInspectionAfterRepair   DateTime?
  challanNo                     String?
  challanDate                   DateTime?
  deliveredToAcos               String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@map("damaged_transformers")
}

model NewGPReceiptRecord {
  id                        String   @id @default(cuid())
  deliveryChallanId         String   @unique
  accountReceiptNoteNo      String
  accountReceiptNoteDate    DateTime
  sinNo                     String
  consigneeName             String
  discomReceiptNoteNo       String
  discomReceiptNoteDate     DateTime
  remarks                   String?
  trfsiNo                   String
  rating                    String
  sealNoTimeOfGPReceived    String
  consigneeTFRSerialNo      String
  originalTfrSrNo           String
  oilLevel                  String
  hvBushing                 String
  lvBushing                 String
  htMetalParts              String
  ltMetalParts              String
  mAndpBox                  String
  mAndpBoxCover             String
  mccb                      String
  icb                       String
  copperFlexibleCable       String
  alWire                    String
  conservator               String
  radiator                  String
  fuse                      String
  channel                   String
  core                      String
  polySealNo                String
  gpReceiptNoteId           String?
  gpReceiptNote             GPReceiptNote? @relation(fields: [gpReceiptNoteId], references: [id])
  failureAnalysis         FailureAnalysis?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  
  deliveryChallan           DeliveryChallan @relation(fields: [deliveryChallanId], references: [id])

  @@map("new_gp_receipt_records")
}

model MaterialOfferedButNominationPending {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("material_offered_but_nomination_pendings")
}

model NominationDone {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("nomination_dones")
}

model InspectionDone {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inspection_dones")
}

model DIReceived {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("di_receiveds")
}

model ProductionPlanning {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("production_plannings")
}

model NewGPTransformer {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("new_gp_transformers")
}

model NewGPSummary {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("new_gp_summaries")
}

model SupplyGPExpiredStatement {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supply_gp_expired_statements")
}

model GPExtendedWarrantyInformation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("gp_extended_warranty_informations")
}
